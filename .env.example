# Gelato Seller API (Product catalog & shipment prices)
GELATO_API_KEY=your_gelato_api_key_here

# Etsy Open API v3 (https://developers.etsy.com)
ETSY_API_KEY=your_etsy_api_keystring_here

# Pinterest Trends API v5 (https://developers.pinterest.com)
PINTEREST_ACCESS_TOKEN=your_pinterest_oauth_token_here

# eBay Browse API (https://developer.ebay.com - OAuth Client Credentials Bearer Token)
EBAY_ACCESS_TOKEN=your_ebay_oauth_token_here

# Google Sheets Service Account JSON (tek satır JSON string veya dosya yolu)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
